PORT=4030
CORS_ORIGINS=

# Gateway trust (same shared secret configured on api-gateway).
GATEWAY_SHARED_SECRET=replace-with-gateway-shared-secret
ALLOW_INSECURE_AUTH=false
AUTH_KEYS=

# Maximum allowed length of insight text (characters).
INSIGHT_CHAR_LIMIT=250

# Direct brand DB connection (preferred when set). Every brand's schema lives
# on these shared hosts, selected per-request via `USE <brand_key>`. Writes go
# to DB_URL; reads go to READ_REPLICA_URL (falls back to DB_URL if unset).
DB_URL=
DB_USER=
DB_PASSWORD=
DB_PORT=3306
READ_REPLICA_URL=

# Tenant/brand database routing — used as a fallback when DB_URL/DB_USER/
# DB_PASSWORD are not all set (mirrors analytics service conventions).
TENANT_ROUTER_URL=http://tenant-router:3004
TENANT_ROUTER_TOKEN=
TENANT_ROUTER_TIMEOUT_MS=5000
TENANT_ROUTER_CACHE_TTL_MS=300000
TENANT_ROUTER_CACHE_SIZE=200
PASSWORD_AES_KEY=replace-with-same-key-as-analytics-service

# LOCAL_MODE=true resolves brand DB connection info from <BRAND>_DB_* env vars
# instead of calling tenant-router (matches analytics service local-dev convention).
LOCAL_MODE=false
